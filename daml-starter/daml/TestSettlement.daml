-- Settlement tests: the mandate controlling real Token Standard value
-- movement, against the mock registry in TestToken.daml.
--
-- The structural facts these tests lean on:
--   * `ChargeAndSettle` validates the fields of the exact `Transfer` record
--     it then exercises. There are no separate "policy" amount/recipient
--     arguments, so the adversarial tests attack the only surface that
--     exists: the transfer object itself, the mandate lifecycle, and the
--     authority model.
--   * The transfer FACTORY is not an argument: the owner pins it into the
--     mandate, and only the owner can re-point it. A malicious orchestrator
--     holding the spender's credentials has no factory-substitution surface.
--   * The cap bounds the owner's GROSS DEBIT (inputs minus change), so
--     registry fees count against it and a lying registry that fakes the
--     accounting is caught or capped.
module TestSettlement where

import DA.Date (Month(Jan), date)
import DA.Time (addRelTime, hours, minutes, time)
import Daml.Script
import Mandate
import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV1
import Splice.Api.Token.TransferInstructionV1
import TestToken

emptyExtra : ExtraArgs
emptyExtra = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata

mkTransfer : InstrumentId -> Party -> Party -> Decimal -> [ContractId Holding] -> Time -> Transfer
mkTransfer instrumentId sender receiver amount inputHoldingCids now = Transfer with
  sender; receiver; amount; instrumentId
  requestedAt = now
  executeBefore = addRelTime now (hours 1)
  inputHoldingCids
  meta = emptyMetadata

data Setup = Setup with
  registry    : Party
  alice       : Party  -- owner: the funding party
  agent       : Party  -- spender: the AI agent
  bob         : Party  -- allowed, preapproved: direct settlement
  carol       : Party  -- allowed, NOT preapproved: offer path
  outsider    : Party
  inst        : InstrumentId
  factoryMock : ContractId MockTransferFactory
  factoryCid  : ContractId TransferFactory  -- same contract, interface view
  holdingCid  : ContractId Holding  -- alice's 1000.0 position
  mandateCid  : ContractId Mandate  -- cap 100.0, allowed [bob, carol], 24h,
                                    -- pinned to factoryCid

mkSetup : Script Setup
mkSetup = script do
  registry <- allocateParty "Registry"
  alice    <- allocateParty "Alice"
  agent    <- allocateParty "Agent"
  bob      <- allocateParty "Bob"
  carol    <- allocateParty "Carol"
  outsider <- allocateParty "Outsider"
  now      <- getTime
  let inst = InstrumentId with admin = registry; id = "CC"
  fCid <- submit registry do
    createCmd MockTransferFactory with
      admin = registry
      observers = [alice, agent, outsider]
      preapproved = [bob]
      fee = 0.0
  hCid <- submit registry do
    createCmd MockHolding with
      admin = registry; owner = alice; instrumentId = inst
      amount = 1000.0; observers = [agent]
  prop <- submit alice do
    createCmd MandateProposal with
      owner = alice; spender = agent; allowed = [bob, carol]
      cap = 100.0; expiresAt = addRelTime now (hours 24); instrument = inst
      factory = toInterfaceContractId fCid
  mandateCid <- submit agent do exerciseCmd prop Accept
  pure Setup with
    registry; alice; agent; bob; carol; outsider; inst
    factoryMock = fCid
    factoryCid = toInterfaceContractId fCid
    holdingCid = toInterfaceContractId hCid
    mandateCid

-- | Prove the authority model, do not assume it.
--
-- `TransferFactory_Transfer` is controlled by `transfer.sender`. The agent
-- alone therefore CANNOT exercise it with the owner's money. Inside a Mandate
-- choice, the authority context is the mandate's signatories (owner AND
-- spender) plus the choice controller, so the owner's authority is available
-- for the nested exercise. The mandate contract IS the owner's standing
-- authorisation, which is exactly the point.
testNestedAuthority : Script ()
testNestedAuthority = script do
  s@Setup{..} <- mkSetup
  now <- getTime
  let t = mkTransfer inst alice bob 10.0 [holdingCid] now

  -- The agent, submitting alone, cannot drive the factory directly with the
  -- owner's transfer: it lacks the owner's authority.
  submitMustFail agent do
    exerciseCmd factoryCid TransferFactory_Transfer with
      expectedAdmin = registry; transfer = t; extraArgs = emptyExtra
  -- Neither can an outsider.
  submitMustFail outsider do
    exerciseCmd factoryCid TransferFactory_Transfer with
      expectedAdmin = registry; transfer = t; extraArgs = emptyExtra

  -- The owner can, standalone: the factory itself is sound.
  -- (Done last because it spends the holding.)
  res <- submit alice do
    exerciseCmd factoryCid TransferFactory_Transfer with
      expectedAdmin = registry; transfer = t; extraArgs = emptyExtra
  case res.output of
    TransferInstructionResult_Completed {} -> pure ()
    _ -> abort "expected direct completion for a preapproved receiver"

  -- And the same nested pattern through the mandate works with ONLY the
  -- agent's signature on the submission: fresh holding, second transfer.
  h2 <- submit registry do
    createCmd MockHolding with
      admin = registry; owner = alice; instrumentId = inst
      amount = 50.0; observers = [agent]
  let t2 = mkTransfer inst alice bob 10.0 [toInterfaceContractId h2] now
  (_, _, res2) <- submit agent do
    exerciseCmd mandateCid ChargeAndSettle with
      transfer = t2; extraArgs = emptyExtra
  case res2.output of
    TransferInstructionResult_Completed {} -> pure ()
    _ -> abort "expected direct completion through the mandate"

-- | The direct path: policy checked, value moved, receipt says Settled, and
-- the receipt's numbers are the settled transfer's numbers because they are
-- read from the same record. With a fee-free registry, gross debit equals
-- the recipient amount.
testSettleDirect : Script ()
testSettleDirect = script do
  s@Setup{..} <- mkSetup
  now <- getTime

  let t1 = mkTransfer inst alice bob 30.0 [holdingCid] now
  (m2, r1, res1) <- submit agent do
    exerciseCmd mandateCid ChargeAndSettle with
      transfer = t1; extraArgs = emptyExtra

  -- Bob was actually paid, in this transaction.
  bobHoldings <- query @MockHolding bob
  assert (sum (map (\(_, h) -> h.amount) bobHoldings) == 30.0)
  -- The receipt agrees with reality and admits nothing more.
  Some r <- queryContractId alice r1
  assert (r.settlement == Settled)
  assert (r.recipient == bob && r.amount == 30.0)
  assert (r.grossDebit == 30.0 && r.fee == 0.0)
  assert (r.instrument == inst)
  assert (r.spentAfter == 30.0 && r.capAtCharge == 100.0 && r.sequence == 1)
  Some m <- queryContractId alice m2
  assert (m.spent == 30.0 && m.charges == 1)

  -- Spend the change from the first settlement in a second charge: the
  -- factory returned it in the result, no re-query needed.
  let t2 = mkTransfer inst alice bob 20.0 res1.senderChangeCids now
  (m3, r2c, _) <- submit agent do
    exerciseCmd m2 ChargeAndSettle with
      transfer = t2; extraArgs = emptyExtra
  Some r2 <- queryContractId alice r2c
  assert (r2.sequence == 2 && r2.spentAfter == 50.0 && r2.settlement == Settled)
  bobHoldings2 <- query @MockHolding bob
  assert (sum (map (\(_, h) -> h.amount) bobHoldings2) == 50.0)
  -- Alice keeps the rest: 1000 - 30 - 20.
  aliceHoldings <- query @MockHolding alice
  assert (sum (map (\(_, h) -> h.amount) aliceHoldings) == 950.0)

-- | The cap bounds the owner's GROSS DEBIT, fees included, measured
-- on-ledger as inputs minus change. A fee that would push the owner's total
-- outflow past the cap rolls back the ENTIRE settlement atomically - value
-- movement included - even though the recipient amount alone fits.
testGrossDebitFees : Script ()
testGrossDebitFees = script do
  s@Setup{..} <- mkSetup
  now <- getTime
  -- A registry that keeps a flat 2.0 fee per transfer, like Amulet keeps
  -- its fees out of the sender's inputs.
  feeF <- submit registry do
    createCmd MockTransferFactory with
      admin = registry; observers = [alice, agent]
      preapproved = [bob]; fee = 2.0
  prop <- submit alice do
    createCmd MandateProposal with
      owner = alice; spender = agent; allowed = [bob, carol]
      cap = 100.0; expiresAt = addRelTime now (hours 24); instrument = inst
      factory = toInterfaceContractId feeF
  m1 <- submit agent do exerciseCmd prop Accept

  -- Recipient amount exactly at the cap, but gross debit 102 > 100:
  -- the whole transaction must fail, leaving no trace.
  submitMustFail agent do
    exerciseCmd m1 ChargeAndSettle with
      transfer = mkTransfer inst alice bob 100.0 [holdingCid] now
      extraArgs = emptyExtra
  aliceH <- query @MockHolding alice
  assert (sum (map (\(_, h) -> h.amount) aliceH) == 1000.0)
  bobH <- query @MockHolding bob
  assert (null bobH)
  Some m <- queryContractId alice m1
  assert (m.spent == 0.0 && m.charges == 0)
  receipts <- query @ChargeReceipt alice
  assert (null receipts)

  -- A charge that fits including the fee: receipt shows all three numbers.
  (m2, rCid, res) <- submit agent do
    exerciseCmd m1 ChargeAndSettle with
      transfer = mkTransfer inst alice bob 50.0 [holdingCid] now
      extraArgs = emptyExtra
  Some r <- queryContractId alice rCid
  assert (r.amount == 50.0 && r.fee == 2.0 && r.grossDebit == 52.0)
  assert (r.spentAfter == 52.0)
  aliceH2 <- query @MockHolding alice
  assert (sum (map (\(_, h) -> h.amount) aliceH2) == 948.0)
  bobH2 <- query @MockHolding bob
  assert (sum (map (\(_, h) -> h.amount) bobH2) == 50.0)

  -- The exact gross remainder still works: 52 + (46 + 2) = 100.
  (m3, r2Cid, _) <- submit agent do
    exerciseCmd m2 ChargeAndSettle with
      transfer = mkTransfer inst alice bob 46.0 res.senderChangeCids now
      extraArgs = emptyExtra
  Some r2 <- queryContractId alice r2Cid
  assert (r2.spentAfter == 100.0 && r2.grossDebit == 48.0)
  -- And then the mandate is exhausted.
  h5 <- submit registry do
    createCmd MockHolding with
      admin = registry; owner = alice; instrumentId = inst
      amount = 5.0; observers = [agent]
  submitMustFail agent do
    exerciseCmd m3 ChargeAndSettle with
      transfer = mkTransfer inst alice bob 1.0 [toInterfaceContractId h5] now
      extraArgs = emptyExtra

-- | The offer path: the receiver has no preapproval, so the registry would
-- only create a pending TransferInstruction - value would NOT move. The
-- mandate refuses: the whole transaction rolls back, no allowance is
-- consumed, no receipt exists, the sender's holdings are untouched. A
-- committed ChargeAndSettle therefore always means the receiver was paid.
testSettlePendingAborts : Script ()
testSettlePendingAborts = script do
  s@Setup{..} <- mkSetup
  now <- getTime

  -- carol is on the allow-list but has no preapproval.
  submitMustFail agent do
    exerciseCmd mandateCid ChargeAndSettle with
      transfer = mkTransfer inst alice carol 25.0 [holdingCid] now
      extraArgs = emptyExtra

  -- Nothing happened, anywhere.
  carolHoldings <- query @MockHolding carol
  assert (null carolHoldings)
  aliceHoldings <- query @MockHolding alice
  assert (sum (map (\(_, h) -> h.amount) aliceHoldings) == 1000.0)
  Some m <- queryContractId alice mandateCid
  assert (m.spent == 0.0 && m.charges == 0)
  receipts <- query @ChargeReceipt alice
  assert (null receipts)

  -- The mandate is still perfectly usable for a direct-path receiver.
  (_, rCid, _) <- submit agent do
    exerciseCmd mandateCid ChargeAndSettle with
      transfer = mkTransfer inst alice bob 25.0 [holdingCid] now
      extraArgs = emptyExtra
  Some r <- queryContractId alice rCid
  assert (r.settlement == Settled)

-- | Everything a malicious caller might try against the settled path. Each
-- attack is a variation of the ONE transfer object, because that is the only
-- surface: there are no separate policy parameters to disagree with it, and
-- no factory argument to swap.
testSettleAdversarial : Script ()
testSettleAdversarial = script do
  s@Setup{..} <- mkSetup
  now <- getTime
  let charge t = exerciseCmd mandateCid ChargeAndSettle with
        transfer = t; extraArgs = emptyExtra

  -- Exceed the cap outright.
  submitMustFail agent do charge (mkTransfer inst alice bob 100.01 [holdingCid] now)
  -- Pay someone off the allow-list, including the parties the policy
  -- deliberately excludes: the agent itself and the owner.
  submitMustFail agent do charge (mkTransfer inst alice outsider 10.0 [holdingCid] now)
  submitMustFail agent do charge (mkTransfer inst alice agent 10.0 [holdingCid] now)
  submitMustFail agent do charge (mkTransfer inst alice alice 10.0 [holdingCid] now)
  -- Non-positive amounts.
  submitMustFail agent do charge (mkTransfer inst alice bob 0.0 [holdingCid] now)
  submitMustFail agent do charge (mkTransfer inst alice bob (-10.0) [holdingCid] now)
  -- No inputs: gross-debit accounting requires explicit holdings.
  submitMustFail agent do charge (mkTransfer inst alice bob 10.0 [] now)
  -- Duplicate inputs: the same holding listed twice would double-count in
  -- the gross-debit measurement, so it is rejected before anything runs.
  submitMustFail agent do
    charge (mkTransfer inst alice bob 10.0 [holdingCid, holdingCid] now)
  -- Substitute the sender: the funding party is the mandate owner, full stop.
  -- Even with the agent's own funds this must not pass through the mandate.
  agentHolding <- submit registry do
    createCmd MockHolding with
      admin = registry; owner = agent; instrumentId = inst
      amount = 500.0; observers = []
  submitMustFail agent do
    charge (mkTransfer inst agent bob 10.0 [toInterfaceContractId agentHolding] now)
  -- Fund the transfer with someone else's holdings: inputs must be the
  -- owner's (the mandate checks) and in the mandate's instrument.
  submitMustFail agent do
    charge (mkTransfer inst alice bob 10.0 [toInterfaceContractId agentHolding] now)
  -- Wrong instrument under this cap: another token of the same registry, and
  -- a same-named token of a rogue registry.
  submitMustFail agent do
    charge (mkTransfer (InstrumentId registry "OTHER") alice bob 10.0 [holdingCid] now)
  submitMustFail agent do
    charge (mkTransfer (InstrumentId outsider "CC") alice bob 10.0 [holdingCid] now)
  -- Insufficient funding: within the cap, but the inputs cannot cover it.
  -- The registry's own check fails, the transaction rolls back, and no
  -- allowance is consumed and no receipt exists.
  smallHolding <- submit registry do
    createCmd MockHolding with
      admin = registry; owner = alice; instrumentId = inst
      amount = 5.0; observers = [agent]
  submitMustFail agent do
    charge (mkTransfer inst alice bob 50.0 [toInterfaceContractId smallHolding] now)
  Some m <- queryContractId alice mandateCid
  assert (m.spent == 0.0 && m.charges == 0)
  receipts <- query @ChargeReceipt alice
  assert (null receipts)

  -- Sneak past the cap cumulatively: 60 then 50.
  let t60 = mkTransfer inst alice bob 60.0 [holdingCid] now
  (m2, _, res) <- submit agent do charge t60
  let t50 = mkTransfer inst alice bob 50.0 res.senderChangeCids now
  submitMustFail agent do
    exerciseCmd m2 ChargeAndSettle with
      transfer = t50; extraArgs = emptyExtra
  -- The exact remainder still works.
  let t40 = mkTransfer inst alice bob 40.0 res.senderChangeCids now
  (m3, _, _) <- submit agent do
    exerciseCmd m2 ChargeAndSettle with
      transfer = t40; extraArgs = emptyExtra
  -- And then the mandate is exhausted.
  submitMustFail agent do
    exerciseCmd m3 ChargeAndSettle with
      transfer = mkTransfer inst alice bob 0.01 [toInterfaceContractId smallHolding] now
      extraArgs = emptyExtra

-- | The factory is mandate state, set and rotated by the OWNER only. The
-- spender cannot re-point it, and when the registry rotates the factory
-- contract the mandate fails safe until the owner re-authorises.
testFactoryPinnedRotation : Script ()
testFactoryPinnedRotation = script do
  s@Setup{..} <- mkSetup
  now <- getTime

  -- The spender cannot re-point the mandate at a factory of its choosing.
  evil <- submit agent do
    createCmd LyingFactory with admin = agent; observers = [alice, agent]
  submitMustFail agent do
    exerciseCmd mandateCid SetFactory with
      newFactory = toInterfaceContractId evil
  -- Neither can an outsider.
  submitMustFail outsider do
    exerciseCmd mandateCid SetFactory with
      newFactory = toInterfaceContractId evil

  -- The registry rotates its factory: the pinned cid goes stale and the
  -- mandate fails safe (no spend, no receipt).
  submit registry do archiveCmd factoryMock
  submitMustFail agent do
    exerciseCmd mandateCid ChargeAndSettle with
      transfer = mkTransfer inst alice bob 10.0 [holdingCid] now
      extraArgs = emptyExtra

  -- The owner re-points at the registry's new factory; settlement resumes
  -- with only the agent's signature, as before.
  f2 <- submit registry do
    createCmd MockTransferFactory with
      admin = registry; observers = [alice, agent]
      preapproved = [bob]; fee = 0.0
  m2 <- submit alice do
    exerciseCmd mandateCid SetFactory with
      newFactory = toInterfaceContractId f2
  (_, rCid, _) <- submit agent do
    exerciseCmd m2 ChargeAndSettle with
      transfer = mkTransfer inst alice bob 10.0 [holdingCid] now
      extraArgs = emptyExtra
  Some r <- queryContractId alice rCid
  assert (r.settlement == Settled && r.amount == 10.0)

-- | Where the mandate's own defences END and Canton package vetting begins.
-- These tests document the boundary rather than pretend it away: a factory
-- is an interface implementation, and an evil-but-vetted implementation can
-- lie about what it did. What the mandate still guarantees even then:
--   * the spender can never select the evil factory (owner-only pinning);
--   * the evil factory cannot touch the real registry's holdings (it lacks
--     the real admin's authority), so it cannot steal - only grief;
--   * gross-debit accounting books the damage against the cap, so even the
--     griefing is bounded.
-- What it cannot detect: a fake `Settled` receipt from a factory the OWNER
-- was tricked into pinning. That is what package vetting must prevent.
testMaliciousFactoryBoundary : Script ()
testMaliciousFactoryBoundary = script do
  s@Setup{..} <- mkSetup
  now <- getTime

  -- Worst case: the owner is deceived into pinning a lying factory.
  lying <- submit agent do
    createCmd LyingFactory with admin = agent; observers = [alice, agent]
  m2 <- submit alice do
    exerciseCmd mandateCid SetFactory with
      newFactory = toInterfaceContractId lying

  -- The naive lie is caught by gross-debit accounting: the lying factory
  -- does not archive the inputs and returns no change, so the mandate books
  -- the FULL input as debit - which blows the cap here (1000 > 100).
  submitMustFail agent do
    exerciseCmd m2 ChargeAndSettle with
      transfer = mkTransfer inst alice bob 10.0 [holdingCid] now
      extraArgs = emptyExtra

  -- The tight lie goes through: an input of exactly the charged amount.
  -- Result: a FALSIFIED receipt (Settled, nobody paid) and burned
  -- allowance - but no value moved anywhere, and the damage is bounded by
  -- the cap. This is the residual risk that package vetting carries.
  h50 <- submit registry do
    createCmd MockHolding with
      admin = registry; owner = alice; instrumentId = inst
      amount = 50.0; observers = [agent]
  (m3, rCid, _) <- submit agent do
    exerciseCmd m2 ChargeAndSettle with
      transfer = mkTransfer inst alice bob 50.0 [toInterfaceContractId h50] now
      extraArgs = emptyExtra
  Some r <- queryContractId alice rCid
  assert (r.settlement == Settled && r.grossDebit == 50.0)  -- the lie
  bobH <- query @MockHolding bob
  assert (null bobH)                     -- nobody was paid
  Some _ <- queryContractId alice h50    -- and nothing actually left alice
  Some m <- queryContractId alice m3
  assert (m.spent == 50.0)               -- allowance burned, bounded by cap

  -- A factory that tries to actually CONSUME the real holdings without
  -- paying fails on authority: archiving them needs the real registry's
  -- signature, which an evil third-party package does not have. Canton's
  -- authorisation model stops cross-package theft, mandate or no mandate.
  subst <- submit agent do
    createCmd SubstitutingFactory with admin = agent; observers = [alice, agent]
  m4 <- submit alice do
    exerciseCmd m3 SetFactory with newFactory = toInterfaceContractId subst
  submitMustFail agent do
    exerciseCmd m4 ChargeAndSettle with
      transfer = mkTransfer inst alice bob 10.0 [toInterfaceContractId h50] now
      extraArgs = emptyExtra
  Some _ <- queryContractId alice h50    -- untouched
  pure ()

-- | A registry result that lists the same change holding twice would halve
-- the measured gross debit - a cap bypass through the accounting. The
-- mandate's uniqueness assertion rejects it AFTER the transfer ran, which
-- rolls the entire settlement back: balances untouched, nothing spent,
-- no receipt.
testDuplicateChangeRejected : Script ()
testDuplicateChangeRejected = script do
  s@Setup{..} <- mkSetup
  now <- getTime
  dup <- submit registry do
    createCmd DupChangeFactory with
      admin = registry; observers = [alice, agent]
  m2 <- submit alice do
    exerciseCmd mandateCid SetFactory with
      newFactory = toInterfaceContractId dup
  submitMustFail agent do
    exerciseCmd m2 ChargeAndSettle with
      transfer = mkTransfer inst alice bob 10.0 [holdingCid] now
      extraArgs = emptyExtra
  -- Rollback was total: the transfer inside the failed transaction never
  -- happened.
  aliceHoldings <- query @MockHolding alice
  assert (sum (map (\(_, h) -> h.amount) aliceHoldings) == 1000.0)
  bobHoldings <- query @MockHolding bob
  assert (null bobHoldings)
  Some m <- queryContractId alice m2
  assert (m.spent == 0.0 && m.charges == 0)
  receipts <- query @ChargeReceipt alice
  assert (null receipts)

-- | Revocation kills settlement instantly; the agent cannot block it.
testSettleAfterRevocation : Script ()
testSettleAfterRevocation = script do
  s@Setup{..} <- mkSetup
  now <- getTime
  submit alice do exerciseCmd mandateCid Revoke
  submitMustFail agent do
    exerciseCmd mandateCid ChargeAndSettle with
      transfer = mkTransfer inst alice bob 1.0 [holdingCid] now
      extraArgs = emptyExtra

-- | Expiry kills settlement the moment the deadline passes.
testSettleAfterExpiry : Script ()
testSettleAfterExpiry = script do
  setTime (time (date 2025 Jan 1) 0 0 0)
  s@Setup{..} <- mkSetup
  passTime (hours 23)
  now <- getTime
  -- Still inside the window: fine.
  (m2, _, res) <- submit agent do
    exerciseCmd mandateCid ChargeAndSettle with
      transfer = mkTransfer inst alice bob 1.0 [holdingCid] now
      extraArgs = emptyExtra
  passTime (hours 1) >> passTime (minutes 1)
  now2 <- getTime
  submitMustFail agent do
    exerciseCmd m2 ChargeAndSettle with
      transfer = mkTransfer inst alice bob 1.0 res.senderChangeCids now2
      extraArgs = emptyExtra
